<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs', {estilod:'registro.css'}) %>

  <%- include('../partials/header.ejs') %>

    <body>
      <main>
        <h1>
          Inicia sesion o registrate para continuar
        </h1>
        <div class="mensaje">
        <h6>
          <%= mensaje %>
        </h6>
        </div>

        <div class="contenedor">
          <div class="iniciar_sesion">
            <form action="/users/login" method="POST">
              <h1>Tengo cuenta</h1>
              <p><span class="label-text">Email:</span> <input type="text" name="usuario" placeholder="email de usuario"
                  required> </p>
              <p><span class="label-text">Contraseña:</span> <input type="password" name="contrasena"
                  placeholder="Contraseña" required></p>
              <div class="remember"><span class="label-text">Recuerdame</span> <input type="checkbox" name="recordar"></div>
              <button type="submit" class="botoniniciar">Iniciar Sesion</button>
            </form>
            <a href="">Olvide mi contraseña</a>
          </div>

          <div class="registrarse">
            <form action="/users/registro" method="POST" enctype="multipart/form-data">
              <h1>Soy nuevo</h1>
              <p><span class="label-text">Nombre:</span> <input type="text" name="nombre" placeholder="Nombre" required>
              </p>
              <p><span class="label-text">Apellido:</span> <input type="text" name="apellido" placeholder="Apellido"
                  required></p>
              <p><span class="label-text">Correo:</span> <input type="email" name="correo" placeholder="Correo"
                  required></p>
              <p><span class="label-text">Telefono Celular:</span> <input type="text" name="telefono"
                  placeholder="Telefono sin 0 ni 15" required>
              </p>
              <p><span class="label-text">Direccion</span> <input type="text" name="direccion"
                  placeholder="Calle, Nro, Ciudad" required></p>
              <p><span class="label-text">Nombre de Usuario Nuevo:</span> <input type="text" name="usuario"
                  placeholder="Usuario" required></p>
              <p><span class="label-text">Contraseña Nueva:</span> <input type="password" name="contrasena1"
                  placeholder="Contraseña" required></p>
              <p><span class="label-text">Repetir Contraseña Nueva:</span> <input type="password" name="contrasena2"
                  placeholder="Repetir Contraseña" required></p>
              <p><span class="label-text">Elegir Imagen de Perfil</span> <input type="file" id="image" name="imagen">
              </p>
              <button type="submit" class="botonregistrar">Crear Cuenta</button>
            </form>

          </div>
        </div>
        <p>¿Estas teniendo problemas? Por favor envianos un mail a <a
            href="mailto:correo@example.com">soporte@luzify.com.ar</a></p>

      </main>
      <%- include('../partials/footer.ejs') %>
        <%- include('../partials/scripts.ejs') %>
    </body>

</html>