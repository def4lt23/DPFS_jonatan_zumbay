<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs', {estilod:'registro.css'}) %>

  <%- include('../partials/header.ejs') %>

    <body>
      <main>
        <h1>
          Inicia sesion o registrate para continuar
        </h1>

        <div class="contenedor">
          <div class="iniciar_sesion">
            <h1>Tengo cuenta</h1>
            <p><span class="label-text">Usuario:</span> <input type="text" placeholder="Usuario"> </p>
            <p><span class="label-text">Contraseña:</span> <input type="password" placeholder="Contraseña"></p>
            <button class="botoniniciar">Iniciar Sesion</button>
            <a href="">Olvide mi contraseña</a>
          </div>

          <div class="registrarse">
            <h1>Soy nuevo</h1>
            <p><span class="label-text">Nombre:</span> <input type="text" placeholder="Nombre"></p>
            <p><span class="label-text">Apellido:</span> <input type="text" placeholder="Apellido"></p>
            <p><span class="label-text">Correo:</span> <input type="email" placeholder="Correo"></p>
            <p><span class="label-text">Telefono Celular:</span> <input type="text" placeholder="Telefono sin 0 ni 15">
            </p>
            <p><span class="label-text">Nombre de Usuario Nuevo:</span> <input type="text" placeholder="Usuario"></p>
            <p><span class="label-text">Contraseña Nueva:</span> <input type="password" placeholder="Contraseña"></p>
            <button class="botonregistrar">Crear Cuenta</button>

          </div>
        </div>
        <p>¿Estas teniendo problemas? Por favor envianos un mail a <a
            href="mailto:correo@example.com">soporte@luzify.com.ar</a></p>

      </main>
      <%- include('../partials/footer.ejs') %>
    </body>

</html>