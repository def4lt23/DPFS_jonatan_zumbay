<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head.ejs', {estilod:'eliminarusuario.css'}) %>

  <body>
    <%- include('../partials/header.ejs') %>

    <h1>ELIMINAR USUARIO</h1>
    <h6><%= mensaje %></h6>

    <div class="contenedor">
      <h4>Para eliminar tu cuenta completa los siguientes pasos</h4>

      <form action="/users/eliminarUsuario/<%= userLogged.id %>?_method=DELETE" method="post">
        <div class="clasep">
          <label for="email">Email</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            placeholder="Ingrese su email" 
            required
          >
        </div>

        <div class="clasep">
          <br>
          <label for="contrasena">Contraseña</label>
          <input 
            type="password" 
            id="contrasena" 
            name="contrasena" 
            placeholder="Ingrese su contraseña"
            required
          >
        </div>

        <div class="clasec">
          <br>
          <label for="seguro">Estoy seguro de borrar esta cuenta</label>
          <input 
            type="checkbox" 
            id="seguro" 
            name="seguro" 
            required
          >
        </div>

        <div class="botones">
          <div>
            <button type="submit" class="boton">ELIMINAR</button>
          </div>
          <div>
            <a class="boton" href="/">Cancelar</a>
          </div>
        </div>
      </form>
    </div> <!-- contenedor -->

    <%- include('../partials/footer.ejs') %>
    <%- include('../partials/scripts.ejs') %>
  </body>
</html>
