<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs', {estilod:'carrito.css'}) %>

  <body>

    <%- include('../partials/header.ejs') %>

      <main>
        <div class="titulo">
          <h1>Termina la compra para recibir nuestros productos en la puerta de tu casa</h1>
        </div>

        <div class="contenedor">
          <% let total=0; %>

            <% if (cart && cart.items.length> 0) { %>
              <% cart.items.forEach(item=> { %>
                <% total +=item.quantity * item.product.price; %>
                  <div class="item-caja" data-cartitemid="<%= item.id %>">
                    <img src="/images/products/<%= item.product.images[0].name %>" alt="Imagen del Producto"
                      class="item-imagen">
                    <div class="item-detalles">
                      <p class="item-descripcion">
                        <%= item.product.name %>
                      </p>
                      <p class="item-precio">$<%= item.product.price %>
                      </p>
                      <select class="item-cantidad">
                        <% for(let i=1; i<=item.product.stock; i++) { %>
                          <option value="<%= i %>" <%=i===item.quantity ? 'selected' : '' %>><%= i %>
                          </option>
                          <% } %>
                      </select>
                      <button class="item-quitar">Quitar</button>
                    </div>
                  </div>
                  <% }) %>

                    <div class="total-carrito">
                      <h2>Total a pagar: $<%= total %>
                      </h2>
                      <br>
                      <button class="botonpagar">PAGAR</button>
                      <button class="item-quitar" id="vaciarCarrito">VACIAR CARRITO</button>
                    </div>

                    <% } else { %>
                      <div class="contvacio">
                      <h2>Tu carrito está vacío</h2>
                      <img src="/images/lampvacia.png" alt="">
                      </div>
                      <% } %>
        </div>
      </main>


      <%- include('../partials/footer.ejs') %>
        <%- include('../partials/scripts.ejs') %>
  </body>

</html>