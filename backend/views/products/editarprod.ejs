<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs', {estilod:'editarprod.css'}) %>

<body>
    <%- include('../partials/header.ejs') %>

    <% if (productodb) { %>
        <h1>ESTAS EDITANDO EL PRODUCTO:</h1>
        <h1><%= productodb.name %></h1>

        <div class="contenedor">
            <form action="/products/editarprod/<%= productodb.id %>?_method=PUT" method="post" enctype="multipart/form-data">
                <div class="clasep">
                    <label for="nombre">1️⃣➡️NOMBRE DEL PRODUCTO:</label>
                    <input type="text" id="nombre" name="nombre" value="<%= productodb.name %>" required>
                </div>

                <div class="clasep">
                    <label for="descripcion">2️⃣➡️DESCRIPCION:</label>
                    <textarea id="descripcion" name="descripcion" rows="4" cols="90" required><%= productodb.description %></textarea>
                </div>

                <div class="clasep">
                    <label for="opciones">3️⃣➡️TIPO DE LAMPARA:</label>
                    <select id="opciones" name="modeloId">
                        <% modelsdb.forEach(function(tipo) { %>
                            <option value="<%= tipo.id %>" <%= productodb.modelId === tipo.id ? 'selected' : '' %>>
                                <%= tipo.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="clasep">
                    <label for="precio">4️⃣➡️PRECIO:</label>
                    <input type="text" id="precio" name="precio" value="<%= productodb.price %>" required min="0" step="0.01">
                </div>

                <fieldset class="claser">
                    <legend>5️⃣➡️COLOR:</legend>
                    <% colorsdb.forEach(function(color) { %>
                        <label>
                            <input type="checkbox" name="colorIdVista" value="<%= color.id %>"
                            <%= productodb.colors.some(c => c.id === color.id) ? 'checked' : '' %>> <!-- usar some porque son objetos-->
                            <%= color.name %>
                        </label>
                    <% }) %>
                    <br><br>
                </fieldset>

                <fieldset class="claser">
                    <legend>6️⃣➡️TAMAÑO DEL PRODUCTO</legend>
                    <label>
                        <input type="radio" name="tamano" value="Mediana" <%= productodb.size === 'Mediana' ? 'checked' : '' %> required>
                        Mediana
                    </label>
                    <label>
                        <input type="radio" name="tamano" value="Grande" <%= productodb.size === 'Grande' ? 'checked' : '' %>>
                        Grande
                    </label>
                </fieldset>

                <br>

                <div class="clasep">
                    <label for="stock">7️⃣➡️CANTIDAD:</label>
                    <input type="number" id="stock" name="stock" value="<%= productodb.stock %>"
                    placeholder="Añade la cantidad del producto nuevo" min="0" required>
                </div>

                <div class="clasep">
                    <label for="image">8️⃣➡️IMAGENES DEL PRODUCTO (⚠️si se sube imagenes se eliminaran las anteriores⚠️)</label>
                    <input type="file" id="image" name="imagen" multiple>
                    <div class="imagen">
                        <div class="fade-slider">
                            <% productodb.images.forEach(function(img, index) { %>
                                <img src="/images/products/<%= img.name %>"
                                alt="Imagen <%= index + 1 %>" class="<%= index === 0 ? 'active-image' : '' %>">
                            <% }) %>
                        </div>
                    </div>
                </div>

                <fieldset class="claser">
                    <legend>9️⃣➡️¿AGREGAR ESTE PRODUCTO A DESTACADOS?</legend>
                    <label>
                        <input type="radio" name="destacado" value="SI" <%= productodb.featured ? 'checked' : '' %> required>
                        SI
                    </label>
                    <label>
                        <input type="radio" name="destacado" value="NO" <%= !productodb.featured ? 'checked' : '' %>>
                        NO
                    </label>
                </fieldset>

                <br>

                <div class="botones">
                    <button type="submit" class="botoneditar">EDITAR PRODUCTO</button>
                    <a class="botoneditar" href="/products/productos">❌ Cancelar</a>
                </div>
            </form>
        </div>

    <% } else { %>
        <div class="error">
            <h1>Lampara o Producto no encontrado en EDITAR</h1>
            <img src="/images/lamperror.png" alt="">
            <div>
                <a class="botonerror" href="/">Volver a Home</a>
            </div>
        </div>
    <% } %>

    <%- include('../partials/footer.ejs') %>
    <%- include('../partials/scripts.ejs') %>
</body>
</html>
