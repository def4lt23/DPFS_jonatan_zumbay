<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs', {estilod:'productos.css'}) %>

    <body>
        <%- include('../partials/header.ejs') %>
            <main>
                <div class="contenedor_titulo">
                    <h1>TODOS NUESTROS PRODUCTOS</h1>
                    <h6>💲 Valor de los precios en pesos argentinos 💲</h6>
                </div>
                <div class="contenedor">
                    <div class="filtro">
                        <p>FILTROS DE LAMPARAS</p>

                        <form method="GET" action="/products/productos">

                            <!-- Desktop: checkboxes -->
                            <div class="checkbox-group desktop-only">
                                <% models.forEach(m=> { %>
                                    <label>
                                        <input type="checkbox" name="modelos" value="<%= m.name %>" <%=filtros.modelos
                                            && (Array.isArray(filtros.modelos) ? filtros.modelos.includes(m.name) :
                                            filtros.modelos===m.name) ? 'checked' : '' %>>
                                        <%= m.name %>
                                    </label>
                                    <% }) %>
                            </div>

                            <!-- Mobile: select simple -->
                            <div class="select-container mobile-only">
                                <select name="modelos">
                                    <option value="">Selecciona un modelo</option>
                                    <% models.forEach(m=> { %>
                                        <option value="<%= m.name %>" <%=filtros.modelos===m.name ? 'selected' : '' %>>
                                            <%= m.name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>

                            <!-- Ordenamiento -->
                            <div class="select-container order-by-select">
                                <select name="orden">
                                    <option value="">Ordenar por</option>
                                    <option value="precio-asc" <%=filtros.orden==='precio-asc' ? 'selected' : '' %>
                                        >Precio: Menor a Mayor</option>
                                    <option value="precio-desc" <%=filtros.orden==='precio-desc' ? 'selected' : '' %>
                                        >Precio: Mayor a Menor</option>
                                </select>
                            </div>

                            <div class="botones-filtros">
                                <button class="botonbase" type="submit">Aplicar</button>
                                <a href="/products/productos" class="botonbase">Limpiar filtros</a>
                                <% if (userLogged.role==="admin" ) { %>
                                        <a class="botonbase" href="/products/crearprod">AÑADIR UN PRODUCTO (ADMIN)</a>
                                        <a class="botonbase" href="/products/editarPropiedad">EDITAR PROPIEDADES (ADMIN)</a>
                                    <% } %>
                            </div>
                        </form>

                    </div>

                    <div class="cartas">
                        <% productsdb.forEach(prodi=> { %>
                            <div class="card">
                                <div class="product-image-slider">
                                    <h3>
                                        <%= prodi.name %>
                                    </h3>
                                    <div class="image-wrapper">
                                        <!-- recorrer las imagenes de cada producto -->
                                        <% prodi.images.forEach((imgObj, index)=> { %>
                                            <img src="/images/products/<%= imgObj.name %>" alt="Imagen <%= index + 1 %>"
                                                class="<%= index === 0 ? 'active-image' : '' %>">
                                            <% }) %>
                                    </div>
                                    <!-- Botones debajo de la imagen -->
                                    <div class="slider-controls">
                                        <button class="slider-btn prev-btn"><i
                                                class="fa-solid fa-backward-step"></i></button>
                                        <button class="slider-btn agregar-carrito" data-product-id="<%= prodi.id %>">
                                            <i class="far fa-heart"></i>
                                        </button>
                                        <button class="slider-btn next-btn"><i
                                                class="fa-solid fa-forward-step"></i></button>
                                    </div>
                                </div>

                                <p class="cartaprecio">
                                    Precio: $<%= prodi.price %>
                                </p>
                                <a href="/products/detalle/<%= prodi.id %>" class="btn-ver-detalles">Ver Detalles</a>
                            </div>
                            <% }) %>
                    </div>

                </div>

            </main>
            <%- include('../partials/footer.ejs') %>
                <%- include('../partials/scripts.ejs') %>
    </body>

</html>